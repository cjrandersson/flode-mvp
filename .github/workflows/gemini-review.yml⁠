name: Gemini PR Review

on:
  pull_request:
    branches:
      - cpp-pod-v0
      - main
    types: [opened, synchronize]

permissions:
  contents: read
  pull-requests: write

jobs:
  review:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          pip install google-genai

      - name: Generate PR Diff and Run Gemini Review
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
          BASE_REF: ${{ github.event.pull_request.base.ref }}
        run: |
          python -c "
          import os, subprocess
          from google import genai

          # 1. Hämta git diff för PR
          base_ref = os.environ['BASE_REF']
          diff_cmd = ['git', 'diff', f'origin/{base_ref}...HEAD']
          try:
              diff_output = subprocess.check_output(diff_cmd).decode('utf-8')
          except Exception as e:
              print(f'Kunde inte hämta diff: {e}')
              exit(0)

          if not diff_output.strip():
              print('Ingen diff funnen, hoppar över review.')
              exit(0)

          # Kapa diff om den är extremt stor för att rymmas väl i prompten
          if len(diff_output) > 60000:
              diff_output = diff_output[:60000] + '\n... [Diff kapad på grund av storlek]'

          # 2. Skicka till Gemini API
          client = genai.Client(api_key=os.environ['GEMINI_API_KEY'])
          prompt = f'''Du är en senior C++ ljudmjukvaruingenjör och CDO som granskar en PR för projektet flöde~ (POD v0).

          Granska följande git diff med fokus på:
          1. Trådsäkerhet i ljudmiljön (lock-free regler, inga minnesallokeringar i audiotråden, atomisk telemetri).
          2. Följsamhet mot PodUIAdapter-gränsen och arkitekturen.
          3. Renhet, C++20-konventioner och prestanda.

          Git Diff:
          \`\`\`diff
          {diff_output}
          \`\`\`

          Ge en kort, koncis och konstruktiv kodgranskning på svenska med konkreta förbättringsförslag om några problem upptäcks.'''

          response = client.models.generate_content(
              model='gemini-2.5-flash',
              contents=prompt
          )

          review_text = f'## 🤖 Gemini Code Review\n\n{response.text}'

          # 3. Publicera kommentar på PR via GitHub CLI
          pr_number = os.environ['PR_NUMBER']
          subprocess.run(['gh', 'pr', 'comment', pr_number, '--body', review_text], check=True)
          "
